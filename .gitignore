# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
!.idea/codeStyles/
!.idea/vcs.xml

# Keystore files (WARNING: Never commit your keystore files)
*.jks
*.keystore

# ...except the public test key. It is deliberately committed so CI and local
# builds share one signing certificate. It signs nothing that ships.
!app/testkey.jks

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Mac OS X hidden files
.DS_Store
